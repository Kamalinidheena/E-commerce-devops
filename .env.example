# IncidentPulse Environment Configuration Example
# Copy this file to .env for production or custom local overrides.
# DO NOT commit real secrets, API keys, or private passwords to version control.

# Flask Application Settings
FLASK_ENV=production
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
PORT=5000
HOST=0.0.0.0

# Database
DATABASE_PATH=instance/incidentpulse.db

# Monitoring Engine Configuration
MONITORING_DEFAULT_INTERVAL=30
MONITORING_MIN_INTERVAL=5
MONITORING_MAX_INTERVAL=3600
MONITORING_DEFAULT_TIMEOUT=5
MONITORING_MAX_TIMEOUT=30

# Security / SSRF Protection
# Set to 'false' in production. Set to 'true' only in local development / demo mode.
ALLOW_LOCAL_DEMO=true

# Notification Settings (Optional default webhook)
DEFAULT_WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=3
